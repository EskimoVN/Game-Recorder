<Window x:Class="Odx.App.JoinRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="odx.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DangoDialog}" FocusManager.FocusedElement="{Binding ElementName=CodeBox}">
    <!-- Texts come from Strings, set by the owner. -->
    <StackPanel Margin="20,18" MinWidth="280" MaxWidth="380">
        <TextBlock x:Name="Prompt" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBox x:Name="CodeBox" AutomationProperties.AutomationId="CodeBox" MaxLength="6" CharacterCasing="Upper"
                 FontFamily="Consolas" FontSize="22" MinHeight="44" HorizontalContentAlignment="Center"
                 TextChanged="Code_Changed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" AutomationProperties.AutomationId="OkButton" IsDefault="True" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" MinWidth="88" Click="Ok_Click" />
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
