<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odx Capture" Icon="odx.ico" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DangoWindow}">
    <!-- Texts come from Strings (English / Vietnamese), set in code-behind. -->
    <Grid Background="{StaticResource BackdropBrush}" RenderOptions.BitmapScalingMode="HighQuality">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <!-- Decorative mark: three dango on a skewer in the theme colours. -->
                    <Canvas Width="36" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle Canvas.Top="4.5" Width="36" Height="1" Fill="{StaticResource InputLineBrush}" />
                        <Ellipse Canvas.Left="0" Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                        <Ellipse Canvas.Left="12" Width="10" Height="10" Fill="{StaticResource MochiBrush}" />
                        <Ellipse Canvas.Left="24" Width="10" Height="10" Fill="{StaticResource MatchaBrush}" />
                    </Canvas>
                    <TextBlock VerticalAlignment="Center" FontSize="15"><Run Text="Odx" FontFamily="Bahnschrift SemiBold, Segoe UI Semibold" /><Run Text=" Capture" Foreground="{StaticResource TextSecondaryBrush}" /></TextBlock>
                </StackPanel>
            </Border>

            <!-- Capture and Room cards share one label column width (SharedSizeGroup) so their fields line up. -->
            <StackPanel Margin="12" Grid.IsSharedSizeScope="True">
                <StackPanel.Resources>
                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="Margin" Value="0,0,10,8" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="8,0,0,8" />
                    </Style>
                </StackPanel.Resources>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="LanguageLabel" Grid.Row="0" />
                        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Grid.Row="0" Grid.Column="1"
                                  Margin="0,0,0,8" Width="140" HorizontalAlignment="Left" DisplayMemberPath="Name"
                                  SelectionChanged="Language_Changed" />

                        <Label x:Name="SourceLabel" Grid.Row="1" />
                        <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox" Grid.Row="1" Grid.Column="1"
                                  Margin="0,0,0,8" DisplayMemberPath="Label" />
                        <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Click="Refresh_Click" />

                        <Label x:Name="GameLabel" Grid.Row="2" />
                        <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox" Grid.Row="2" Grid.Column="1"
                                  Grid.ColumnSpan="2" SelectionChanged="Game_Changed"
                                  Margin="0,0,0,8" DisplayMemberPath="Label" />

                        <Label x:Name="FpsLabel" Grid.Row="3" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="FpsBox" Width="80" />
                            <CheckBox x:Name="AudioBox" AutomationProperties.AutomationId="AudioBox" Margin="14,0,0,0"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <Label x:Name="ObsLabel" Grid.Row="4" />
                        <CheckBox x:Name="ObsBox" AutomationProperties.AutomationId="ObsBox" Grid.Row="4" Grid.Column="1"
                                  Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Checked="Obs_Changed" Unchecked="Obs_Changed" />

                        <!-- OBS connection row: shown only while "Record with OBS" is ticked. -->
                        <Label x:Name="ObsConnectionLabel" Grid.Row="5" />
                        <StackPanel x:Name="ObsConnectionPanel" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="ObsAddressLabel" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="ObsAddressBox" AutomationProperties.AutomationId="ObsAddressBox" Width="112" />
                            <TextBlock x:Name="ObsPasswordLabel" VerticalAlignment="Center" Margin="10,0,6,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <PasswordBox x:Name="ObsPasswordBox" AutomationProperties.AutomationId="ObsPasswordBox" Width="92" />
                        </StackPanel>
                        <Button x:Name="ObsTestButton" AutomationProperties.AutomationId="ObsTestButton" Grid.Row="5" Grid.Column="2"
                                Click="ObsTest_Click" />
                    </Grid>
                </Border>

                <!-- Room card: follows RoomPanel, which the code hides when odx-capture.json names no orchestrator. -->
                <Border Style="{StaticResource Card}" Visibility="{Binding Visibility, ElementName=RoomPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="PlayerLabel" Grid.Row="0" />
                        <StackPanel x:Name="PlayerPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="PlayerBox" AutomationProperties.AutomationId="PlayerBox" Width="150" />
                            <Label x:Name="NameLabel" Margin="14,0,10,0" />
                            <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox" Width="150" />
                        </StackPanel>

                        <Label x:Name="RoomLabel" Grid.Row="1" />
                        <StackPanel x:Name="RoomPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- The current room's invite code, selectable so the host can copy it; the code to join is asked in a dialog. -->
                            <TextBox x:Name="RoomBox" AutomationProperties.AutomationId="RoomBox" Width="110" IsReadOnly="True"
                                     Visibility="Collapsed" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                     HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="JoinButton" AutomationProperties.AutomationId="JoinButton" Margin="0,0,8,0"
                                    Click="Join_Click" />
                            <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton" Margin="0"
                                    Click="Create_Click" />
                        </StackPanel>

                        <!-- The host names each round (the folder every player's capture and the delivered session get):
                             <batch>-S<video>, the batch typed once and kept, the video number advancing by itself (S01..S15). -->
                        <TextBlock x:Name="TaskLabel" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center"
                                   Margin="0,0,10,8" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel x:Name="TaskPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBox x:Name="TaskBox" AutomationProperties.AutomationId="TaskBox" Width="96"
                                     FontFamily="Consolas" TextChanged="TaskBatch_Changed" />
                            <TextBlock Text="-S" VerticalAlignment="Center" FontFamily="Consolas" Margin="4,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="VideoBox" AutomationProperties.AutomationId="VideoBox" Width="56"
                                      FontFamily="Consolas" SelectionChanged="TaskVideo_Changed" />
                        </StackPanel>

                        <!-- Shown while the Windows clock is off NTP: runs odx clock-sync as administrator. -->
                        <Button x:Name="SyncClockButton" AutomationProperties.AutomationId="SyncClockButton" Grid.Row="3"
                                Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed"
                                Click="SyncClock_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="HotkeyLabel" Grid.Row="0" />
                        <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox" Grid.Row="0" Grid.Column="1"
                                 Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus"
                                 PreviewKeyDown="Hotkey_PreviewKeyDown" />

                        <!-- Turns red-outlined while the recording timer runs (its dot is shown), so the stop state reads at a glance. -->
                        <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton" Grid.Row="1"
                                Grid.ColumnSpan="2" Margin="0,4,0,0" Padding="12,10" MinHeight="40" FontSize="14"
                                Click="StartStop_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible">
                                            <Setter Property="Background" Value="{StaticResource RecordTintBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource RecordBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource RecordTintHoverBrush}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible" />
                                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource RecordTintPressedBrush}" />
                                        </MultiDataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DisabledLineBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Recording time: red with a dot while it runs, grey once stopped (keeps the last recording's length).
                             The dot is Hidden, not Collapsed, so the digits do not shift when it appears. -->
                        <StackPanel x:Name="RecordTimerPanel" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                    HorizontalAlignment="Left" Margin="0,12,0,4">
                            <Ellipse x:Name="RecordTimerDot" Width="12" Height="12" Fill="{StaticResource RecordBrush}"
                                     Margin="2,0,10,0" VerticalAlignment="Center" Visibility="Hidden" />
                            <TextBlock x:Name="RecordTimerText" AutomationProperties.AutomationId="RecordTimerText" Text="00:00:00"
                                       FontFamily="Consolas" FontSize="32" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" TextOptions.TextFormattingMode="Ideal" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Grid.Row="3"
                                   Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,4,0,8" />
                    </Grid>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
