<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dango Capture" Icon="odx.ico" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DangoWindow}">
    <!-- Texts come from Strings (English / Vietnamese), set in code-behind. -->
    <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource MistBrush}"
            BorderBrush="{StaticResource HeaderLineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <StackPanel Orientation="Horizontal">
            <!-- Dango glyph: pink, white and green dumplings on a skewer. Decorative. -->
            <Canvas Width="38" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                <Rectangle Canvas.Top="6" Width="38" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource StickBrush}" />
                <Ellipse Canvas.Left="2" Canvas.Top="1" Width="12" Height="12" Fill="{StaticResource SakuraBrush}" Stroke="#D9849A" />
                <Ellipse Canvas.Left="13" Canvas.Top="1" Width="12" Height="12" Fill="#FFFFFF" Stroke="#CFC2C8" />
                <Ellipse Canvas.Left="24" Canvas.Top="1" Width="12" Height="12" Fill="{StaticResource YomogiBrush}" Stroke="#7FB37A" />
            </Canvas>
            <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="Dango" Foreground="{StaticResource AccentBrush}" /><Run Text=" Capture" /></TextBlock>
        </StackPanel>
    </Border>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="Margin" Value="0,0,8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="6,0,0,6" />
                <Setter Property="Padding" Value="10,2" />
            </Style>
        </Grid.Resources>

        <Label x:Name="LanguageLabel" Grid.Row="0" />
        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Grid.Row="0" Grid.Column="1"
                  Margin="0,0,0,6" Width="140" HorizontalAlignment="Left" DisplayMemberPath="Name"
                  SelectionChanged="Language_Changed" />

        <Label x:Name="SourceLabel" Grid.Row="1" />
        <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox" Grid.Row="1" Grid.Column="1"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />
        <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Click="Refresh_Click" />

        <Label x:Name="GameLabel" Grid.Row="2" />
        <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox" Grid.Row="2" Grid.Column="1"
                  SelectionChanged="Game_Changed"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />

        <Label x:Name="FpsLabel" Grid.Row="3" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="FpsBox" Width="80" />
            <CheckBox x:Name="AudioBox" AutomationProperties.AutomationId="AudioBox" Margin="12,0,0,0"
                      VerticalAlignment="Center" />
        </StackPanel>

        <Label x:Name="ObsLabel" Grid.Row="4" />
        <CheckBox x:Name="ObsBox" AutomationProperties.AutomationId="ObsBox" Grid.Row="4" Grid.Column="1"
                  Margin="0,0,0,6" VerticalAlignment="Center" Checked="Obs_Changed" Unchecked="Obs_Changed" />

        <!-- OBS connection row: shown only while "Record with OBS" is ticked. -->
        <Label x:Name="ObsConnectionLabel" Grid.Row="5" />
        <StackPanel x:Name="ObsConnectionPanel" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="ObsAddressLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="ObsAddressBox" AutomationProperties.AutomationId="ObsAddressBox" Width="120"
                     VerticalContentAlignment="Center" />
            <TextBlock x:Name="ObsPasswordLabel" VerticalAlignment="Center" Margin="12,0,4,0" />
            <PasswordBox x:Name="ObsPasswordBox" AutomationProperties.AutomationId="ObsPasswordBox" Width="100"
                         VerticalContentAlignment="Center" />
        </StackPanel>
        <Button x:Name="ObsTestButton" AutomationProperties.AutomationId="ObsTestButton" Grid.Row="5" Grid.Column="2"
                Click="ObsTest_Click" />

        <!-- Room rows: shown only when odx-capture.json names an orchestrator. -->
        <Label x:Name="PlayerLabel" Grid.Row="6" />
        <StackPanel x:Name="PlayerPanel" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBox x:Name="PlayerBox" AutomationProperties.AutomationId="PlayerBox" Width="150" VerticalContentAlignment="Center" />
            <Label x:Name="NameLabel" Margin="12,0,8,0" />
            <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox" Width="150" VerticalContentAlignment="Center" />
        </StackPanel>

        <Label x:Name="RoomLabel" Grid.Row="7" />
        <StackPanel x:Name="RoomPanel" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
            <!-- The current room's invite code, selectable so the host can copy it; the code to join is asked in a dialog. -->
            <TextBox x:Name="RoomBox" AutomationProperties.AutomationId="RoomBox" Width="110" IsReadOnly="True"
                     Visibility="Collapsed" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            <!-- The host names each round (the folder every player's capture and the delivered session get):
                 <batch>-S<video>, the batch typed once and kept, the video number advancing by itself (S01..S15). -->
            <TextBlock x:Name="TaskLabel" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,4,0" />
            <StackPanel x:Name="TaskPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0">
                <TextBox x:Name="TaskBox" AutomationProperties.AutomationId="TaskBox" Width="96"
                         VerticalContentAlignment="Center" FontFamily="Consolas" TextChanged="TaskBatch_Changed" />
                <TextBlock Text="-S" VerticalAlignment="Center" FontFamily="Consolas" Margin="2,0" />
                <ComboBox x:Name="VideoBox" AutomationProperties.AutomationId="VideoBox" Width="52"
                          FontFamily="Consolas" SelectionChanged="TaskVideo_Changed" />
            </StackPanel>
            <Button x:Name="JoinButton" AutomationProperties.AutomationId="JoinButton" Click="Join_Click" />
            <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton" Click="Create_Click" />
            <!-- Shown while the Windows clock is off NTP: runs odx clock-sync as administrator. -->
            <Button x:Name="SyncClockButton" AutomationProperties.AutomationId="SyncClockButton" Visibility="Collapsed"
                    Click="SyncClock_Click" />
        </StackPanel>

        <Label x:Name="HotkeyLabel" Grid.Row="8" />
        <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox" Grid.Row="8" Grid.Column="1"
                 Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center"
                 GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus"
                 PreviewKeyDown="Hotkey_PreviewKeyDown" />

        <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton" Grid.Row="9"
                Grid.ColumnSpan="3" Margin="0,8,0,8" Padding="0,8" FontSize="14" Click="StartStop_Click"
                Style="{StaticResource PrimaryButton}" />

        <!-- Recording time: red with a dot while it runs, grey once stopped (keeps the last recording's length).
             The dot is Hidden, not Collapsed, so the digits do not shift when it appears. -->
        <StackPanel x:Name="RecordTimerPanel" Grid.Row="10" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="0,0,0,8">
            <Ellipse x:Name="RecordTimerDot" Width="14" Height="14" Fill="{StaticResource RecordBrush}" Margin="0,0,10,0"
                     VerticalAlignment="Center" Visibility="Hidden" />
            <TextBlock x:Name="RecordTimerText" AutomationProperties.AutomationId="RecordTimerText" Text="00:00:00"
                       FontFamily="Consolas" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Grid.Row="11"
                   Grid.ColumnSpan="3" TextWrapping="Wrap" />
    </Grid>
    </DockPanel>
</Window>
