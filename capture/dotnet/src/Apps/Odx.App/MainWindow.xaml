<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Odx.App"
        Title="{x:Static local:Brand.Name}" Icon="odx.ico" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DangoWindow}">
    <!-- Texts come from Strings (English / Vietnamese), set in code-behind. -->
    <Window.Resources>
        <!-- Eskimo 1.0.0: a StatusRow's mark: green check, amber "!", red cross, or a ring for information. -->
        <DataTemplate x:Key="RowMark" DataType="{x:Type local:StatusRow}">
            <Grid Width="16" Height="16">
                <Ellipse x:Name="Disc" Fill="{StaticResource MatchaBrush}" />
                <TextBlock x:Name="Glyph" Text="✓" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{StaticResource MatchaInkBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter TargetName="Disc" Property="Fill" Value="{StaticResource WarnBrush}" />
                    <Setter TargetName="Glyph" Property="Text" Value="!" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Fail">
                    <Setter TargetName="Disc" Property="Fill" Value="{StaticResource RecordBrush}" />
                    <Setter TargetName="Glyph" Property="Text" Value="✕" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource FailInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Info">
                    <Setter TargetName="Disc" Property="Fill" Value="Transparent" />
                    <Setter TargetName="Disc" Property="Stroke" Value="{StaticResource TextMutedBrush}" />
                    <Setter TargetName="Disc" Property="StrokeThickness" Value="1.5" />
                    <Setter TargetName="Disc" Property="Width" Value="8" />
                    <Setter TargetName="Disc" Property="Height" Value="8" />
                    <Setter TargetName="Glyph" Property="Text" Value="" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Room status: mark, label column, text. -->
        <DataTemplate x:Key="RoomRowTemplate" DataType="{x:Type local:StatusRow}">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowMark}" VerticalAlignment="Top"
                                  Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0,12,0" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <!-- Quick check: only the rows that are not OK, value in Consolas, what to do after it. -->
        <DataTemplate x:Key="QuickRowTemplate" DataType="{x:Type local:StatusRow}">
            <DockPanel Margin="3,6,0,0">
                <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource RowMark}"
                                  VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Margin="8,0,8,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Text}" FontFamily="Consolas" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Hint}" Margin="10,0,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource BackdropBrush}" RenderOptions.BitmapScalingMode="HighQuality">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="76" Background="{StaticResource HeaderArtBrush}" Padding="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Eskimo 1.0.0: the team's logo; the name's first word bold, the rest dimmer (Brand.Name, set in code). -->
                    <Image Source="logo.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock VerticalAlignment="Center" FontSize="20"><Run x:Name="BrandFirst" FontFamily="Bahnschrift SemiBold, Segoe UI Semibold" /><Run x:Name="BrandRest" Foreground="{StaticResource TextSecondaryBrush}" /></TextBlock>
                    <!-- The build's version (without the commit), so a screenshot tells which package a player runs. -->
                    <Border CornerRadius="10" Padding="9,2" Margin="12,0,0,0" BorderThickness="1" VerticalAlignment="Center"
                            BorderBrush="{StaticResource HairlineBrush}" Background="#33000000">
                        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Capture and Room cards share one label column width (SharedSizeGroup) so their fields line up. -->
            <StackPanel Margin="12" Grid.IsSharedSizeScope="True">
                <StackPanel.Resources>
                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="Margin" Value="0,0,10,8" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="8,0,0,8" />
                    </Style>
                </StackPanel.Resources>

                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource SakuraCardLineBrush}">
                    <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Style="{StaticResource SectionDot}" Fill="{StaticResource SakuraBrush}" />
                        <TextBlock x:Name="SectionSourceText" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="LanguageLabel" Grid.Row="0" />
                        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Grid.Row="0" Grid.Column="1"
                                  Margin="0,0,0,8" Width="140" HorizontalAlignment="Left" DisplayMemberPath="Name"
                                  SelectionChanged="Language_Changed" />

                        <Label x:Name="SourceLabel" Grid.Row="1" />
                        <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox" Grid.Row="1" Grid.Column="1"
                                  Margin="0,0,0,8" DisplayMemberPath="Label" />
                        <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Click="Refresh_Click" />

                        <Label x:Name="GameLabel" Grid.Row="2" />
                        <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox" Grid.Row="2" Grid.Column="1"
                                  Grid.ColumnSpan="2" SelectionChanged="Game_Changed"
                                  Margin="0,0,0,8" DisplayMemberPath="Label" />

                        <Label x:Name="FpsLabel" Grid.Row="3" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="FpsBox" Width="80" />
                            <CheckBox x:Name="AudioBox" AutomationProperties.AutomationId="AudioBox" Margin="14,0,0,0"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <Label x:Name="ObsLabel" Grid.Row="4" />
                        <CheckBox x:Name="ObsBox" AutomationProperties.AutomationId="ObsBox" Grid.Row="4" Grid.Column="1"
                                  Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Checked="Obs_Changed" Unchecked="Obs_Changed" />

                        <!-- OBS connection row: shown only while "Record with OBS" is ticked. -->
                        <Label x:Name="ObsConnectionLabel" Grid.Row="5" />
                        <StackPanel x:Name="ObsConnectionPanel" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="ObsAddressLabel" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="ObsAddressBox" AutomationProperties.AutomationId="ObsAddressBox" Width="112" />
                            <TextBlock x:Name="ObsPasswordLabel" VerticalAlignment="Center" Margin="10,0,6,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <PasswordBox x:Name="ObsPasswordBox" AutomationProperties.AutomationId="ObsPasswordBox" Width="92" />
                        </StackPanel>
                        <Button x:Name="ObsTestButton" AutomationProperties.AutomationId="ObsTestButton" Grid.Row="5" Grid.Column="2"
                                Click="ObsTest_Click" />
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- Room card: follows RoomPanel, which the code hides when odx-capture.json names no orchestrator. -->
                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource ShiroCardLineBrush}"
                        Visibility="{Binding Visibility, ElementName=RoomPanel}">
                    <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Style="{StaticResource SectionDot}" Fill="{StaticResource ShiroBrush}" />
                        <TextBlock x:Name="SectionRoomText" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="PlayerLabel" Grid.Row="0" />
                        <StackPanel x:Name="PlayerPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="PlayerBox" AutomationProperties.AutomationId="PlayerBox" Width="150" />
                            <Label x:Name="NameLabel" Margin="14,0,10,0" />
                            <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox" Width="150" />
                        </StackPanel>

                        <Label x:Name="RoomLabel" Grid.Row="1" />
                        <StackPanel x:Name="RoomPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- The current room's invite code, selectable so the host can copy it; the code to join is asked in a dialog. -->
                            <TextBox x:Name="RoomBox" AutomationProperties.AutomationId="RoomBox" Width="110" IsReadOnly="True"
                                     Visibility="Collapsed" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                     HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="JoinButton" AutomationProperties.AutomationId="JoinButton" Margin="0,0,8,0"
                                    Click="Join_Click" />
                            <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton" Margin="0"
                                    Click="Create_Click" />
                        </StackPanel>

                        <!-- The host names each round (the folder every player's capture and the delivered session get):
                             <batch>-S<video>, the batch typed once and kept, the video number advancing by itself (S01..S15). -->
                        <TextBlock x:Name="TaskLabel" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center"
                                   Margin="0,0,10,8" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel x:Name="TaskPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBox x:Name="TaskBox" AutomationProperties.AutomationId="TaskBox" Width="96"
                                     FontFamily="Consolas" TextChanged="TaskBatch_Changed" />
                            <TextBlock Text="-S" VerticalAlignment="Center" FontFamily="Consolas" Margin="4,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="VideoBox" AutomationProperties.AutomationId="VideoBox" Width="56"
                                      FontFamily="Consolas" SelectionChanged="TaskVideo_Changed" />
                        </StackPanel>

                        <!-- Shown while the Windows clock is off NTP: runs odx clock-sync as administrator. -->
                        <Button x:Name="SyncClockButton" AutomationProperties.AutomationId="SyncClockButton" Grid.Row="3"
                                Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed"
                                Click="SyncClock_Click" />
                    </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource MatchaCardLineBrush}" Margin="0">
                    <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Matcha while idle, red while the recording timer runs. -->
                        <Ellipse>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource SectionDot}">
                                    <Setter Property="Fill" Value="{StaticResource MatchaSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible">
                                            <Setter Property="Fill" Value="{StaticResource RecordBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="SectionRecordText" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="HotkeyLabel" Grid.Row="0" />
                        <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox" Grid.Row="0" Grid.Column="1"
                                 Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus"
                                 PreviewKeyDown="Hotkey_PreviewKeyDown" />

                        <!-- Turns solid red while the recording timer runs (its dot is shown), so the stop state reads at a glance. -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <Border CornerRadius="12" Margin="14,10,14,-4" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="18" />
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource MatchaSoftBrush}" />
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible">
                                            <Setter Property="Background" Value="{StaticResource RecordBrush}" />
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled, ElementName=StartStopButton}" Value="False">
                                            <Setter Property="Opacity" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton"
                                Padding="12,12" MinHeight="46" FontSize="15"
                                Click="StartStop_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible">
                                            <Setter Property="Background" Value="{StaticResource RecordSolidBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource RecordSolidPressedBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource RecordSolidHoverBrush}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Visibility, ElementName=RecordTimerDot}" Value="Visible" />
                                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource RecordSolidPressedBrush}" />
                                        </MultiDataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DisabledLineBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        </Grid>

                        <!-- Recording time: red with a dot while it runs, grey once stopped (keeps the last recording's length).
                             The dot is Hidden, not Collapsed, so the digits do not shift when it appears. -->
                        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,4" LastChildFill="False">
                        <!-- Eskimo: the round's 4 minutes as a skewer, one dango per 80 s; the recording stops itself at the last. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="148" Height="16" IsHitTestVisible="False">
                                <Rectangle x:Name="SkewerTrack" Canvas.Top="7" Width="140" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="{StaticResource SkewerTrackBrush}" />
                                <Rectangle x:Name="SkewerFill" Canvas.Top="7" Width="0" Height="2" RadiusX="1" RadiusY="1"
                                           Fill="{StaticResource SkewerWoodBrush}" />
                                <Ellipse Canvas.Left="39.7" Canvas.Top="1" Width="14" Height="14" StrokeThickness="1.5"
                                         Stroke="{StaticResource SakuraBrush}" Opacity="0.45" Fill="{StaticResource CardBrush}" />
                                <Ellipse x:Name="SkewerDango1" Canvas.Left="39.7" Canvas.Top="1" Width="14" Height="14"
                                         Fill="{StaticResource SakuraBrush}" Opacity="0" />
                                <Ellipse Canvas.Left="86.3" Canvas.Top="1" Width="14" Height="14" StrokeThickness="1.5"
                                         Stroke="{StaticResource ShiroBrush}" Opacity="0.45" Fill="{StaticResource CardBrush}" />
                                <Ellipse x:Name="SkewerDango2" Canvas.Left="86.3" Canvas.Top="1" Width="14" Height="14"
                                         Fill="{StaticResource ShiroBrush}" Opacity="0" />
                                <Ellipse Canvas.Left="133" Canvas.Top="1" Width="14" Height="14" StrokeThickness="1.5"
                                         Stroke="{StaticResource MatchaSoftBrush}" Opacity="0.45" Fill="{StaticResource CardBrush}" />
                                <Ellipse x:Name="SkewerDango3" Canvas.Left="133" Canvas.Top="1" Width="14" Height="14"
                                         Fill="{StaticResource MatchaSoftBrush}" Opacity="0" />
                            </Canvas>
                            <TextBlock Text="04:00" FontFamily="Consolas" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="RecordTimerPanel" DockPanel.Dock="Left" Orientation="Horizontal">
                            <Ellipse x:Name="RecordTimerDot" Width="12" Height="12" Fill="{StaticResource RecordBrush}"
                                     Margin="2,0,10,0" VerticalAlignment="Center" Visibility="Hidden" />
                            <TextBlock x:Name="RecordTimerText" AutomationProperties.AutomationId="RecordTimerText" Text="00:00:00"
                                       FontFamily="Consolas" FontSize="32" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" TextOptions.TextFormattingMode="Ideal" />
                            <!-- "REC" beside the time while it runs; follows the dot. -->
                            <Border CornerRadius="10" Padding="9,2" Margin="14,0,0,0" BorderThickness="1" VerticalAlignment="Center"
                                    Background="{StaticResource RecordChipBrush}" BorderBrush="{StaticResource RecordBrush}"
                                    Visibility="{Binding Visibility, ElementName=RecordTimerDot}">
                                <TextBlock Text="REC" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,4">
                            <!-- Eskimo 1.0.0: this machine's quick check of the last round: one "all OK" line, or only the
                                 rows that failed (red) or warn (amber). Colors follow Tag (the worst RowLevel), set in code. -->
                            <Border x:Name="QuickPanel" AutomationProperties.AutomationId="QuickPanel" Visibility="Collapsed"
                                    CornerRadius="10" Padding="12,10" Margin="0,4,0,8" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource OkPanelBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource OkPanelLineBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="Warn">
                                                <Setter Property="Background" Value="{StaticResource WarnPanelBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource WarnPanelLineBrush}" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="Fail">
                                                <Setter Property="Background" Value="{StaticResource FailPanelBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource FailPanelLineBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <ContentPresenter x:Name="QuickMark" DockPanel.Dock="Left" VerticalAlignment="Center"
                                                          ContentTemplate="{StaticResource RowMark}">
                                            <ContentPresenter.LayoutTransform>
                                                <ScaleTransform ScaleX="1.375" ScaleY="1.375" />
                                            </ContentPresenter.LayoutTransform>
                                        </ContentPresenter>
                                        <TextBlock x:Name="QuickSourceText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="QuickTitleText" AutomationProperties.AutomationId="QuickTitleText"
                                                   Margin="10,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                                    </DockPanel>
                                    <ItemsControl x:Name="QuickRows" Focusable="False" ItemTemplate="{StaticResource QuickRowTemplate}" />
                                </StackPanel>
                            </Border>
                            <!-- Eskimo 1.0.0: the room's state as marked rows (room, players, clock, capture, audio, LAN, packets). -->
                            <ItemsControl x:Name="RoomRows" Focusable="False" Visibility="Collapsed" Grid.IsSharedSizeScope="True"
                                          Margin="0,0,0,4" ItemTemplate="{StaticResource RoomRowTemplate}" />
                            <Border Padding="10,7" CornerRadius="8" Background="{StaticResource SheenBrush}">
                                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
