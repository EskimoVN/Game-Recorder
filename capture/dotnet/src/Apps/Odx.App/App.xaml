<Application x:Class="Odx.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme (team Dango). Rose = brand, focus and checked states; matcha = the one main action and success;
         red = recording and errors only. Text on cards is WCAG AA or more over the dark background image. -->
    <Application.Resources>
        <SolidColorBrush x:Key="VoidBrush" Color="#120E18" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#D9120E18" />
        <SolidColorBrush x:Key="CardBrush" Color="#C41A1522" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1522" />
        <SolidColorBrush x:Key="PopupBrush" Color="#1E1828" />
        <SolidColorBrush x:Key="PopupLineBrush" Color="#3A2F45" />
        <SolidColorBrush x:Key="GlassBrush" Color="#F01A1522" />
        <SolidColorBrush x:Key="OverlayGlassBrush" Color="#E0120E18" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="SheenBrush" Color="#14FFFFFF" />
        <LinearGradientBrush x:Key="CardLineBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2EFFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="0.3" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TextBrush" Color="#F3EEF4" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BDB3C2" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9A90A3" />
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6578" />

        <SolidColorBrush x:Key="InputBrush" Color="#120E18" />
        <SolidColorBrush x:Key="InputLineBrush" Color="#5E5068" />
        <SolidColorBrush x:Key="InputHoverLineBrush" Color="#8A7896" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#261F2E" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#312839" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1D1824" />
        <SolidColorBrush x:Key="ButtonLineBrush" Color="#45394F" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#2E2438" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#1A1520" />
        <SolidColorBrush x:Key="DisabledLineBrush" Color="#2E2636" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#45394F" />

        <SolidColorBrush x:Key="AccentBrush" Color="#E46A92" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#EC86A8" />
        <SolidColorBrush x:Key="AccentTintBrush" Color="#33222C" />
        <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#3D2834" />
        <SolidColorBrush x:Key="AccentInkBrush" Color="#1A0B11" />
        <SolidColorBrush x:Key="MochiBrush" Color="#D9DCE3" />
        <SolidColorBrush x:Key="MatchaBrush" Color="#4FA872" />
        <SolidColorBrush x:Key="MatchaHoverBrush" Color="#5CB880" />
        <SolidColorBrush x:Key="MatchaPressedBrush" Color="#43925F" />
        <SolidColorBrush x:Key="MatchaInkBrush" Color="#07130C" />
        <SolidColorBrush x:Key="RecordBrush" Color="#F25450" />
        <SolidColorBrush x:Key="RecordTintBrush" Color="#3A1A1C" />
        <SolidColorBrush x:Key="RecordTintHoverBrush" Color="#4A2023" />
        <SolidColorBrush x:Key="RecordTintPressedBrush" Color="#2E1517" />

        <!-- One dango per card: sakura = capture source, shiro = room, matcha = recording. -->
        <SolidColorBrush x:Key="SakuraBrush" Color="#F2A7BE" />
        <SolidColorBrush x:Key="ShiroBrush" Color="#F3E9D2" />
        <SolidColorBrush x:Key="MatchaSoftBrush" Color="#8CC79A" />
        <SolidColorBrush x:Key="RecordChipBrush" Color="#33F25450" />
        <LinearGradientBrush x:Key="MatchaGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9ED3AB" Offset="0" />
            <GradientStop Color="#7CB98A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MatchaGradientHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ABDCB7" Offset="0" />
            <GradientStop Color="#89C596" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MatchaGradientPressedBrush" Color="#74AE82" />
        <SolidColorBrush x:Key="MatchaDeepInkBrush" Color="#0D1F13" />
        <!-- Stop state: white text on these reds stays above 4.5:1. -->
        <LinearGradientBrush x:Key="RecordSolidBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CC3A36" Offset="0" />
            <GradientStop Color="#B92D29" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="RecordSolidHoverBrush" Color="#C23430" />
        <SolidColorBrush x:Key="RecordSolidPressedBrush" Color="#A82824" />

        <!-- Card title: a coloured dot and a small capitalised label. -->
        <Style x:Key="SectionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- bg.jpg is a <Resource> in the csproj: a missing pack resource fails at startup. -->
        <ImageBrush x:Key="BackdropBrush" ImageSource="pack://application:,,,/bg.jpg"
                    Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top" />
        <!-- header.png: the dango skewer sits in the right quarter, so nothing is placed there. -->
        <ImageBrush x:Key="HeaderArtBrush" ImageSource="pack://application:,,,/header.png"
                    Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />

        <!-- Keyboard-only focus ring, drawn outside the control so it never hides content. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2"
                                   Stroke="{StaticResource AccentBrush}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit Window styles skip derived classes (MainWindow, JoinRoomDialog), so these are applied by key. -->
        <Style x:Key="DangoWindow" TargetType="Window">
            <Setter Property="Background" Value="{StaticResource VoidBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="DangoDialog" TargetType="Window" BasedOn="{StaticResource DangoWindow}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>

        <LinearGradientBrush x:Key="SakuraCardLineBrush" StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="#99F2A7BE" Offset="0" />
            <GradientStop Color="#1FFFFFFF" Offset="0.3" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ShiroCardLineBrush" StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="#8CF3E9D2" Offset="0" />
            <GradientStop Color="#1FFFFFFF" Offset="0.3" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MatchaCardLineBrush" StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="#998CC79A" Offset="0" />
            <GradientStop Color="#1FFFFFFF" Offset="0.3" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SkewerWoodBrush" Color="#C9A27A" />
        <SolidColorBrush x:Key="SkewerTrackBrush" Color="#3A2F45" />
        <SolidColorBrush x:Key="HoverGlowBrush" Color="#14FFFFFF" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12,16,6" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="0,4" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PopupBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PopupLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="{StaticResource ScrollThumbBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource InputLineBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource InputHoverLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBar" TargetType="ScrollBar">
            <Grid Width="10" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBar" TargetType="ScrollBar">
            <Grid Height="10" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverGlow" CornerRadius="7" Background="{StaticResource HoverGlowBrush}"
                                        Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="Sheen" CornerRadius="7" BorderThickness="0,1,0,0"
                                        BorderBrush="{StaticResource SheenBrush}" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource InputLineBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledLineBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The disabled trigger is repeated last so it wins over this style's own colours. -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverGlow" CornerRadius="11" Background="#1FFFFFFF" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="Sheen" CornerRadius="11" BorderThickness="0,1,0,0" BorderBrush="#40FFFFFF"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="HoverGlow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{StaticResource MatchaGradientBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MatchaGradientPressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MatchaDeepInkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MatchaGradientHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource MatchaGradientPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledLineBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared by TextBox and PasswordBox. Colours change through style triggers, not template triggers, so a local
             BorderBrush (TaskBox's red error border) still wins. -->
        <Style x:Key="InputBase" TargetType="Control">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputHoverLineBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="6,2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledLineBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource InputBase}">
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                <Path x:Name="Arrow" Width="10" Height="6" Margin="0,1,6,0" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Data="M1,1 L5,5 L9,1" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{StaticResource TextSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Non-editable only (the app has no editable combo). -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0,2,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.ColumnSpan="2" Focusable="False" IsTabStop="False" ClickMode="Press"
                                          Template="{StaticResource ComboToggleTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" VerticalOffset="4"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <!-- The margin leaves room for the shadow inside the transparent popup window. -->
                                <Grid Margin="0,0,10,12" MinWidth="{Binding ActualWidth, ElementName=Root}">
                                    <Border CornerRadius="8" Background="{StaticResource PopupBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270"
                                                              Opacity="0.55" Color="#000000" />
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="8" Background="{StaticResource PopupBrush}"
                                            BorderBrush="{StaticResource PopupLineBrush}" BorderThickness="1" Padding="4"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputHoverLineBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledLineBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="Marker" Width="2" Margin="-6,1,0,1" HorizontalAlignment="Left"
                                           RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="IsHighlighted" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AccentTintHoverBrush}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Path x:Name="CheckMark" Data="M3,7 L6,10 L11,4" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{StaticResource AccentInkBrush}" Visibility="Collapsed" />
                                    <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1"
                                               Fill="{StaticResource AccentInkBrush}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="Text" Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Text" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource HighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource DisabledBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DisabledLineBrush}" />
                                <Setter TargetName="CheckMark" Property="Stroke" Value="{StaticResource TextDisabledBrush}" />
                                <Setter TargetName="Dash" Property="Fill" Value="{StaticResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputHoverLineBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
